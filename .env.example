# Aydlett Insurance Agency - Environment Configuration
# None of these variables are required for basic deployment.
# The app is fully functional out-of-the-box with client-side verified agency data.

# (Optional) Canonical URL for custom domain deployment:
# VITE_PUBLIC_SITE_URL=https://aydlettins.com

# (Optional) Form endpoint if connecting to Formspree, Basin, or an internal CRM API in the future:
# VITE_QUOTE_SUBMIT_ENDPOINT=
